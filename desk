#!/usr/bin/env bash
# One entry point. Usage: ./desk data | check | report | validate | save | test  [options]
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
py="$here/01-data-pipeline/.venv/bin/python"
if [ -f "$here/.env" ]; then set -a; . "$here/.env"; set +a; fi
cmd="${1:-help}"; shift || true
case "$cmd" in
  data)  cd "$here/01-data-pipeline" && exec "$py" -m pipeline run "$@" ;;
  check) cd "$here/01-data-pipeline" && exec "$py" -m pipeline check "$@" ;;
  report|validate|save) cd "$here/02-valuation" && exec "$py" -m valuation "$cmd" "$@" ;;
  test)  (cd "$here/01-data-pipeline" && "$py" -m pytest -q); cd "$here/02-valuation" && "$py" -m pytest -q ;;
  *)     sed -n 2p "$0"; exit 1 ;;
esac
